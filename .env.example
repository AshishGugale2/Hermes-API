DATABASE_URL=postgresql://ipo:change-me@localhost:5432/ipo
DATABASE_SCHEMA=public
DB_POOL_MAX=10
IPO_CACHE_MINUTES=15
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Compose credentials. Keep CONTAINER_DATABASE_URL aligned with these values.
POSTGRES_DB=ipo
