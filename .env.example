# Copy this file to .env and fill in your actual local values.
# Do not commit the real .env file to Git.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=replace-with-actual-password
SMTP_FROM="IPO Monitor <noreply@example.com>"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IPO_CACHE_MINUTES=15
DATABASE_URL=sqlite:///./data/ipo_monitor.db
